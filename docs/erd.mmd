  USERS ||--o{ REVIEWS : "viết"
  USERS ||--o{ NOTIFICATIONS : "nhận"
  USERS ||--o{ DEVICE_TOKENS : "có"
  VENUES ||--o{ COURTS : "gồm"
  VENUES ||--o{ VENUE_IMAGES : "có ảnh"
  VENUES ||--o{ PRICE_RULES : "có bảng giá"
  VENUES ||--o{ BOOKINGS : "nhận đơn"
  VENUES ||--o{ REVIEWS : "được đánh giá"
  VENUES ||--o{ VENUE_AMENITIES : ""
  AMENITIES ||--o{ VENUE_AMENITIES : ""
  BOOKINGS ||--|{ BOOKING_SLOTS : "gồm"
  COURTS ||--o{ BOOKING_SLOTS : "được giữ"
