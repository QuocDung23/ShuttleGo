PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=shuttlego
DB_PASSWORD=shuttlego
DB_NAME=shuttlego
# Log SQL queries (true/false)
DB_LOGGING=false
# Run pending migrations automatically when the app starts (true/false)
DB_MIGRATIONS_RUN=true

# Secret used to sign JWT access tokens (set a long random value in production).
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (default: 7 days)
JWT_EXPIRES_IN=604800
# Comma-separated list of allowed browser origins. Leave empty to allow all.
CORS_ORIGIN=
