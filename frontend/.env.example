# Backend API base URL for Expo (embedded at build/start time).
# Pick the value that matches where the app runs:
# - Web / iOS Simulator (backend on same machine): http://localhost:3000/api
# - Android Emulator (backend on same machine):    http://10.0.2.2:3000/api
# - Physical device: http://<LAN_IP_OF_DEV_MACHINE>:3000/api
#
# Match backend PORT in backend/.env and allow the web origin in backend CORS_ORIGIN when using Expo web.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
